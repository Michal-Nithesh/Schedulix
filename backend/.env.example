PORT=4000
# Primary frontend origin (local dev by default)
FRONTEND_URL=http://localhost:5173
# Optional extra allowed origins, comma-separated (dev/staging frontend URLs).
# The deployed frontend https://schedulix-delta.vercel.app is always allowed
# alongside http://localhost:5173, so it does not need to be listed here.
CORS_ORIGINS=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DEMO_ADMIN_EMAIL=admin@timetable.demo
DEMO_ADMIN_PASSWORD=change-this-demo-password
DEMO_SCHEDULER_EMAIL=scheduler@timetable.demo
DEMO_SCHEDULER_PASSWORD=change-this-demo-password
DEMO_VIEWER_EMAIL=viewer@timetable.demo
DEMO_VIEWER_PASSWORD=change-this-demo-password
